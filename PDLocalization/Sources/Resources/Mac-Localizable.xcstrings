    "setting_fix_syncing_issues_description" : {
      "comment" : "Fix syncing issues section description",
      "extractionState" : "manual",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі ваша праграма сінхранізуецца няправільна, то паўторная сінхранізацыя забяспечыць абнаўленне ўсіх вашых даных. Гэта можа заняць некалькі хвілін або нават гадзін, калі ў вас шмат файлаў."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la vostra aplicació no se sincronitza correctament, tornar-la a sincronitzar garantirà que totes les vostres dades estiguin actualitzades. Pot trigar uns quants minuts o fins i tot hores si teniu molts fitxers."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis din app ikke synkroniseres korrekt, vil gensynkronisering sikre, at alle dine data er opdaterede. Det kan tage et par minutter eller endda timer, hvis du har mange filer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falls deine App nicht korrekt synchronisiert, sorgt eine erneute Synchronisierung dafür, dass alle deine Daten auf dem neuesten Stand sind. Dies kann einige Minuten oder bei einer großen Anzahl von Dateien sogar mehrere Stunden dauern."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εάν η εφαρμογή σας δε συγχρονίζεται σωστά, ο επανασυγχρονισμός θα διασφαλίσει ότι όλα τα δεδομένα σας είναι ενημερωμένα. Μπορεί να χρειαστούν μερικά λεπτά ή και ώρες εάν έχετε πολλά αρχεία."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If your app is not syncing correctly, resyncing will ensure all your data is up to date. It may take a few minutes or even hours if you have many files."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la aplicación no se sincroniza correctamente, volver a sincronizarla garantizará que todos sus datos estén actualizados. Esto puede tardar unos minutos o incluso horas si tiene muchos archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si votre application ne se synchronise pas correctement, une nouvelle synchronisation vous permettra de vous assurer que toutes vos données sont à jour. Cela peut prendre quelques minutes, voire plusieurs heures si vous avez beaucoup de fichiers."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als uw app niet correct synchroniseert, zorgt het opnieuw synchroniseren ervoor dat al uw gegevens up-to-date zijn. Als u veel bestanden heeft, kan het enkele minuten of zelfs uren duren."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dacă aplicația nu se sincronizează corect, resincronizarea va asigura că toate datele sunt actualizate. Poate dura câteva minute sau chiar ore dacă aveți multe fișiere."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ak sa vaša aplikácia nesynchronizuje správne, opätovná synchronizácia zabezpečí, že všetky vaše údaje budú aktuálne. Ak máte veľa súborov, môže to trvať niekoľko minút alebo dokonca hodín."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanız doğru eşitlenmiyorsa yeniden eşitleme işlemi tüm verilerinizin güncel olmasını sağlar. Dosya sayınız fazlaysa bu işlem birkaç dakika hatta birkaç saat sürebilir."
          }
        }
      }
    },
