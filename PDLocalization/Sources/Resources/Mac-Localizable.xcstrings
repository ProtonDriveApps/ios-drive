    "setting_help_report_encourage_text" : {
      "comment" : "Label text to encourage user report issue",
      "extractionState" : "manual",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Калі ў вас узніклі праблемы, паведаміце нам."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si trobeu algun problema, us convidem a informar-ho."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokud máte nějaké problémy, nahlaste je prosím."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du oplever problemer, bedes du rapportere problemet."
          }
        },
        "de" : {
          "stringUnit" : {
