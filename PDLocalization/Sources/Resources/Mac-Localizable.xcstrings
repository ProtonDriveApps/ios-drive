    "setting_storage_out_of_storage_warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сінхранізацыя прыпынена. Палепшыце тарыфны план або вызваліце месца ў сховішчы, каб узнавіць працэс сінхранізацыі."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'ha pausat la sincronització. Milloreu o allibereu espai per reprendre la sincronització."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizace pozastavena. Pro pokračování navyšte tarif nebo uvolněte místo v úložišti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseringen er sat på pause. Opgrader eller frigør plads for at genoptage synkroniseringen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Synchronisierung wurde pausiert. Bitte aktualisiere oder gib Speicherplatz frei, um die Synchronisierung fortzusetzen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο συγχρονισμός έχει τεθεί σε παύση. Παρακαλούμε αναβαθμίστε ή ελευθερώστε χώρο για να συνεχίσετε το συγχρονισμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syncing has been paused. Please upgrade or free up space to resume syncing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ha pausado la sincronización. Mejora o libera espacio para reanudar la sincronización."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización se ha pausado. Actualice o libere espacio para reanudar la sincronización."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronointi on pysäytetty. Jatka sitä päivittämällä tilauksesi tai vapauttamalla tilaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La synchronisation est en pause. Nous vous invitons à améliorer votre abonnement pour libérer de l'espace et reprendre la synchronisation."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szinkronizálás fel van függesztve. Frissítse a csomagját vagy szabadítson fel helyet a szinkronizálás folytatásához."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinkronisasi telah dijeda. Silakan tingkatkan akun atau kosongkan ruang penyimpanan untuk melanjutkan sinkronisasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione è stata sospesa. Aggiorna o libera spazio per riprendere la sincronizzazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同期は一時停止されました。再開するにはアップグレードするか容量を空けてください。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "სინქრონიზაცია შეჩერდა. სინქრონიზაციის გასაგრძელებლად ასწიეთ სატარიფო გეგმა ან გაათავისუფლეთ ადგილი."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동기화가 중단되었습니다. 동기화를 재개하려면 업그레이드하거나 공간을 비워주세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkroniseringen er satt på pause. Oppgrader eller frigjør plass for å gjenoppta synkroniseringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronisatie is gepauzeerd. Upgrade of maak ruimte vrij om de synchronisatie te hervatten."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizacja została wstrzymana. Ulepsz konto lub zwolnij część miejsce, aby wznowić synchronizację."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização foi pausada. Melhore o seu plano ou liberte espaço para continuar a sincronização."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sincronização foi pausada. Faça upgrade ou libere espaço para retomar a sincronização"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizarea a fost întreruptă. Achiziționați alt tip de abonament sau eliberați spațiu pentru a relua sincronizarea."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронизация приостановлена. Пожалуйста, улучшите или освободите место, чтобы возобновить синхронизацию."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchronizácia bola pozastavená. Ak chcete obnoviť synchronizáciu, upgradujte alebo uvoľnite miesto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronisering har pausats. Uppgradera eller frigör utrymme för att återuppta synkronisering."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eşitleme duraklatıldı. Eşitlemeyi sürdürmek için lütfen tarifenizi yükseltin ya da boş alan açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхронізацію призупинено. Покращте тариф чи звільніть місце для продовження синхронізації."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已暂停。请升级或释放空间以恢复同步。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同步已暫停。請升級或騰出空間以繼續同步。"
          }
        }
      }
    },
