    "full_resync_cancelled_recovery" : {
      "extractionState" : "manual",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Паўторная сінхранізацыя скасавана перад яе завяршэннем. Паўтарыце спробу або стварыце новую папку сінхранізацыі."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La resincronització s'ha cancel·lat abans d'acabar. Torneu-ho a provar o creeu una nova carpeta de sincronització."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resynchronizace byla zrušena před dokončením. Zkuste to znovu nebo vytvořte novou synchronizovanou složku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resynkroniseringen blev annulleret før den blev afsluttet. Prøv igen, eller opret en ny synkroniseringsmappe."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Neusynchronisierung wurde vorzeitig abgebrochen. Versuche es erneut oder erstelle einen neuen Synchronisierungsordner."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο επανασυγχρονισμός ακυρώθηκε πριν ολοκληρωθεί. Δοκιμάστε ξανά ή δημιουργήστε έναν νέο φάκελο συγχρονισμού."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resync was cancelled before it finished. Retry, or create a new sync folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La resincronización se canceló antes de finalizar. Vuelve a intentarlo o crea una nueva carpeta de sincronización."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La resincronización se canceló antes de finalizar. Reintente de nuevo o cree otra carpeta de sincronización."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synkronointi keskeytettiin ennen kuin se ehti päättyä. Yritä uudelleen tai luo uusi synkronointikansio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La resynchronisation a été annulée avant la fin. Réessayez ou créez un nouveau dossier de synchronisation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La risincronizzazione è stata annullata prima del completamento. Riprovare oppure creare una nuova cartella di sincronizzazione."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "თავიდან სინქრონიზაცია დასრულებამდე გაუქმდა. სცადეთ თავიდან, ან შექმენით ახალი სინქრონიზაციის საქაღალდე."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "재동기화가 완료 전에 취소되었습니다. 다시 시도하거나 새로운 동기화 폴더를 생성하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resynkroniseringen ble avbrutt før den var ferdig. Prøv på nytt, eller opprett en ny synkroniseringsmappe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De hersynchronisatie is afgebroken voordat deze was voltooid. Probeer het opnieuw of maak een nieuwe synchronisatiemap aan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ressincronização foi cancelada antes de ser concluída. Tente novamente ou crie uma pasta de sincronização."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resincronizarea a fost anulată înainte de finalizare. Reîncercați sau creați un nou folder de sincronizare."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opätovná synchronizácia bola zrušená pred jej dokončením. Skúste to znova alebo vytvorte nový synchronizačný priečinok."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden eşitleme işlemi tamamlanmadan iptal edildi. Yeniden deneyin ya da yeni bir eşitleme klasörü oluşturun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新同步在完成前已取消！请重试，或新建同步文件夹。"
          }
        }
      }
    },
